# Copy to .env on the owner's machine. Never commit .env. Every value here is a placeholder.

# Where the server listens. 127.0.0.1 keeps it on this computer only.
PORT=8080
HOST=127.0.0.1

# Folder for the SQLite database, cleaned photos, and generated push keys (git-ignored).
FIRE_SALE_DATA=./data

# Optional passcode for the whole app (HTTP Basic auth). Set it before exposing the app beyond localhost.
FIRE_SALE_PASSCODE=

# Contact address that push services see. Use a real mailbox you control.
VAPID_SUBJECT=mailto:owner@example.com

# Ship-from address lines, separated by "|". Leave empty here.
# Fill it at runtime from your password vault, for example:
#   FIRE_SALE_SHIP_FROM="$(op read op://Private/ship-from/lines)" npm start
FIRE_SALE_SHIP_FROM=

# eBay auth is wired later on the owner's machine. v1 never reads these.
EBAY_CLIENT_ID=placeholder
EBAY_CLIENT_SECRET=placeholder

# CapRover on bots.ac sets these on the app, not in this file.
# HOST=0.0.0.0
# PORT=8080
# FIRE_SALE_DATA=/srv/fire-sale/data
