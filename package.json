{
  "name": "static-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build:css": "./bin/tailwindcss -i src/input.css -o public/assets/site.css --minify",
    "watch:css": "./bin/tailwindcss -i src/input.css -o public/assets/site.css --watch",
    "lint:html": "html-validate \"public/**/*.html\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:skills": "sh scripts/check-skills.sh",
    "lint": "npm run lint:skills && npm run lint:html && npm run lint:css && npm run lint:js && npm run lint:md && npm run format:check",
    "serve": "serve -l 8080 public",
    "test:e2e": "playwright test",
    "test:a11y": "pa11y-ci",
    "test:lhci": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/parser": "^0.66.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "markdownlint-cli2": "^0.23.3",
    "pa11y-ci": "^5.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3"
  }
}
